# Server Configuration
PORT=5000

# Database Configuration (MySQL / Aiven / Cloud Provider)
# For Local MySQL:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_local_password
# DB_NAME=support_tickets

# For Cloud MySQL (e.g., Aiven / Railway / AWS RDS):
DB_HOST=your-mysql-host.aivencloud.com
DB_PORT=your_db_port
DB_USER=avnadmin
DB_PASSWORD=your_db_password
DB_NAME=defaultdb

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d
